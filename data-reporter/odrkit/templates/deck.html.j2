<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ deck_title }} — Ops Data Reporter</title>
<script src="{{ plotly_cdn }}"></script>
<style>
{{ css_vars }}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; height: 100%; background: var(--bg); color: var(--text); }
body { font-family: var(--font-body); font-variant-numeric: tabular-nums; -webkit-font-smoothing: antialiased; }

.deck {
  height: 100dvh;
  overflow-y: scroll;
  scroll-snap-type: y mandatory;
  scroll-behavior: smooth;
}

.slide {
  height: 100dvh;
  width: 100%;
  scroll-snap-align: start;
  scroll-snap-stop: always;
  overflow: hidden;
  padding: 3.2rem 4rem 3.6rem;
  position: relative;
  display: flex;
  flex-direction: column;
  border-bottom: 1px solid var(--border);
}

.slide.title-slide {
  background: var(--odr-black);
  color: var(--odr-white);
  justify-content: center;
  align-items: flex-start;
}
.slide.title-slide .eyebrow { color: var(--odr-cyan); }
.slide.title-slide h1 { color: var(--odr-white); font-size: 3rem; margin: 0.4rem 0 1rem; }
.slide.title-slide .subtitle { color: #cccccc; font-size: 1.2rem; max-width: 46rem; }
.slide.title-slide .id-badge {
  margin-top: 2rem; font-size: 0.75rem; letter-spacing: 0.05rem;
  color: var(--odr-cyan); text-transform: uppercase; border: 1px solid var(--odr-cyan);
  padding: 0.3rem 0.7rem; display: inline-block;
}

.slide-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
.eyebrow { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06rem; text-transform: uppercase; color: var(--odr-dark-teal); }
.slide-number { font-size: 0.72rem; color: var(--text-muted); }

h2.slide-title {
  font-size: 1.9rem; font-weight: 700; margin: 0 0 0.3rem 0; color: var(--odr-black);
  text-decoration: underline; text-decoration-color: var(--odr-cyan);
  text-underline-offset: 8px; text-decoration-thickness: 4px; display: inline-block;
}
.slide .subtitle { color: var(--text-dim); font-size: 1.05rem; margin-bottom: 1rem; }

.slide-body { flex: 1; min-height: 0; display: flex; flex-direction: column; }
.slide-body.fill-top { padding-top: 0.4rem; }

.figures-grid { flex: 1; min-height: 0; display: grid; gap: 1rem; grid-auto-flow: column; grid-auto-columns: 1fr; }
.figures-grid .fig-wrap { min-height: 0; height: 100%; width: 100%; }
.figures-grid .fig-wrap > div { height: 100% !important; width: 100% !important; }

.caption { font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem; }

.kpi-strip { display: flex; gap: 1.2rem; flex-wrap: wrap; margin-top: 0.5rem; }
.kpi { background: var(--bg-card); border: 2px solid var(--border); border-top: 3px solid var(--odr-cyan); padding: 1rem 1.4rem; min-width: 12rem; }
.kpi .label { font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.03rem; margin-bottom: 0.3rem; }
.kpi .value { font-size: 2rem; font-weight: 700; color: var(--odr-black); }
.kpi .kpi-sub { font-size: 0.8rem; color: var(--odr-dark-teal); margin-top: 0.2rem; }

.prose-body p { line-height: 1.6; color: var(--text-dim); }

.code-drawer { margin-top: 0.8rem; font-size: 0.78rem; }
.code-drawer summary { cursor: pointer; color: var(--odr-dark-teal); }
.code-drawer pre { background: var(--bg-alt); border: 1px solid var(--border); padding: 0.8rem; overflow: auto; max-height: 30dvh; }

.chart-error { color: var(--odr-red); font-family: var(--font-mono); font-size: 0.85rem; padding: 1rem; border: 1px solid var(--odr-red); }

.slide-footer {
  position: absolute; left: 4rem; right: 4rem; bottom: 1.1rem;
  display: flex; justify-content: space-between; align-items: center;
  font-size: 0.68rem; letter-spacing: 0.04rem; color: var(--text-muted);
}
.slide.title-slide .slide-footer { color: #999999; }
.slide-footer .confidential { font-weight: 700; text-transform: uppercase; }

.disclaimer-slide .disclaimer-body { overflow-y: auto; flex: 1; }
.disclaimer-slide p { font-size: 0.8rem; line-height: 1.55; color: var(--text-dim); text-align: justify; margin: 0 0 0.8rem; }
.synthetic-marker { color: var(--odr-red); font-weight: 700; letter-spacing: 0.03rem; display: block; margin-bottom: 1rem; }

.nav-dots {
  position: fixed; right: 1.1rem; top: 50%; transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 0.5rem; z-index: 10;
}
.nav-dots button {
  width: 8px; height: 8px; border-radius: 0; border: 1px solid var(--text-muted);
  background: transparent; padding: 0; cursor: pointer;
}
.nav-dots button.active { background: var(--odr-cyan); border-color: var(--odr-cyan); }
</style>
</head>
<body>
<div class="deck" id="deck">
{% for slide in slides %}
  <section class="slide {{ slide.css_class }}{% if slide.kind == 'disclaimer' %} disclaimer-slide{% endif %}" data-index="{{ loop.index0 }}" id="slide-{{ loop.index0 }}">
    {% if slide.kind == 'title' %}
      <div class="eyebrow">{{ slide.eyebrow }}</div>
      <h1>{{ slide.title }}</h1>
      <div class="subtitle">{{ slide.subtitle }}</div>
      {% if slide.id_badge %}<div class="id-badge">{{ slide.id_badge }}</div>{% endif %}
    {% elif slide.kind == 'disclaimer' %}
      <div class="slide-header">
        <div class="eyebrow">{{ slide.eyebrow }}</div>
        <div class="slide-number">{{ loop.index }} / {{ total_slides }}</div>
      </div>
      <h2 class="slide-title">{{ slide.title }}</h2>
      {% if synthetic %}<span class="synthetic-marker">{{ synthetic_notice }}</span>{% endif %}
      <div class="disclaimer-body">
        {% for para in disclaimer_paragraphs %}<p>{{ para }}</p>{% endfor %}
      </div>
    {% else %}
      <div class="slide-header">
        <div class="eyebrow">{{ slide.eyebrow }}</div>
        <div class="slide-number">{{ loop.index }} / {{ total_slides }}</div>
      </div>
      {% if slide.title %}<h2 class="slide-title">{{ slide.title }}</h2>{% endif %}
      {% if slide.subtitle %}<div class="subtitle">{{ slide.subtitle }}</div>{% endif %}
      <div class="slide-body {{ 'fill-top' if slide.figures_html else '' }}">
        {% if slide.kind in ('chart', 'chart_grid') %}
          <div class="figures-grid">
            {% for fig_html in slide.figures_html %}
              <div class="fig-wrap">{{ fig_html | safe }}</div>
            {% endfor %}
          </div>
          {% if slide.body_html %}<div class="prose-body">{{ slide.body_html | safe }}</div>{% endif %}
        {% elif slide.kind == 'kpi_row' %}
          <div class="prose-body">{{ slide.body_html | safe }}</div>
        {% else %}
          <div class="prose-body">{{ slide.body_html | safe }}</div>
        {% endif %}
        {% if slide.caption %}<div class="caption">{{ slide.caption }}</div>{% endif %}
        {% if slide.code_html %}{{ slide.code_html | safe }}{% endif %}
      </div>
    {% endif %}
    <div class="slide-footer">
      <span class="confidential">Confidential | Ops Data Reporter</span>
      <span>{{ loop.index }} / {{ total_slides }}</span>
    </div>
  </section>
{% endfor %}
</div>

<div class="nav-dots" id="nav-dots">
  {% for slide in slides %}
  <button data-target="slide-{{ loop.index0 }}" aria-label="Go to slide {{ loop.index }}"></button>
  {% endfor %}
</div>

<script>
(function () {
  var deck = document.getElementById('deck');
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var dots = Array.prototype.slice.call(document.querySelectorAll('#nav-dots button'));

  function setActive(i) {
    dots.forEach(function (d, idx) { d.classList.toggle('active', idx === i); });
  }

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      var target = document.getElementById(dot.getAttribute('data-target'));
      if (target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        setActive(slides.indexOf(entry.target));
      }
    });
  }, { root: deck, threshold: 0.6 });
  slides.forEach(function (s) { observer.observe(s); });

  function currentIndex() {
    var active = dots.findIndex(function (d) { return d.classList.contains('active'); });
    return active === -1 ? 0 : active;
  }

  function goTo(i) {
    i = Math.max(0, Math.min(slides.length - 1, i));
    slides[i].scrollIntoView({ behavior: 'smooth' });
  }

  document.addEventListener('keydown', function (e) {
    if (['ArrowDown', 'PageDown', ' '].includes(e.key)) { e.preventDefault(); goTo(currentIndex() + 1); }
    else if (['ArrowUp', 'PageUp'].includes(e.key)) { e.preventDefault(); goTo(currentIndex() - 1); }
    else if (e.key === 'Home') { e.preventDefault(); goTo(0); }
    else if (e.key === 'End') { e.preventDefault(); goTo(slides.length - 1); }
  });

  if (slides.length) setActive(0);
  window.addEventListener('resize', function () { window.dispatchEvent(new Event('plotly-resize')); });
})();
</script>
</body>
</html>
