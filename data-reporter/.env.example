# Postgres connection for real-data roles (e.g. opsgov_incidents) — see
# CLAUDE.md's real-data-role callout and data/DATA_DICTIONARY.md.
#
# Copy this file to `.env` (gitignored) and fill in real values. odrkit
# loads `.env` automatically (odrkit/data.py, via python-dotenv) and never
# falls back to a hardcoded default — a missing/incomplete .env raises
# odrkit.data.MissingCredentialsError with a clear message instead of
# silently connecting with weak defaults.
#
# Either fill in the individual components below, OR set ODR_PG_DSN to a
# full connection string and skip the rest.

ODR_PG_HOST=localhost
ODR_PG_PORT=5432
ODR_PG_DATABASE=airflow
ODR_PG_USER=admin
ODR_PG_PASSWORD=admin

# ODR_PG_DSN=postgresql://admin:admin@localhost:5432/airflow
